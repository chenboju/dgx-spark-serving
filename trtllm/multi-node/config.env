# Shared settings for the two-node setup. Sourced by every script in this dir.
#
# Adjust NET_IFACE to whatever `ibdev2netdev` reports as the Up port on your
# QSFP link — it is the single most important value here. All of MPI, NCCL and
# UCX get pinned to it explicitly; if they are left to auto-select they will
# happily pick the management ethernet instead and the job silently runs at
# 1 Gbit/s (or hangs).

TRTLLM_IMAGE="nvcr.io/nvidia/tensorrt-llm/release:1.3.0rc7"
CONTAINER_NAME="trtllm_multinode"

NET_IFACE="enp1s0f1np1"

# sshd inside the container listens here. Deliberately not 22 — the host's own
# sshd already owns that, and the container runs with --network host.
MPI_SSH_PORT="2222"

# Path on the host to the OpenMPI hostfile (see hostfile.example).
HOSTFILE="$HOME/openmpi-hostfile"
