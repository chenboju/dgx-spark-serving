# 複製成 .env 後填入實際值，再 source .env
# .env 已在 .gitignore 中，不會被提交

# Hugging Face token：下載 gated 模型（Gemma、Llama 等）必需
# 取得位置 https://huggingface.co/settings/tokens
export HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# vLLM OpenAI-compatible API 的存取金鑰，自行設定任意字串
export VLLM_API_KEY="change-me"

# 選用：HF cache 位置，tools/hf-cache-report.py 會讀
# export HF_HOME_HUB="$HOME/.cache/huggingface/hub"
